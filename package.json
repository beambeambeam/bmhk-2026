{
  "name": "bmhk-2026",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/bun": "^1.3.14",
      "elysia": "^1.4.29",
      "@orpc/server": "^1.14.6",
      "@orpc/openapi": "^1.14.6",
      "@orpc/zod": "^1.14.6",
      "auth": "1.6.29",
      "better-auth": "1.6.29",
      "evlog": "^2.22.0",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.2",
      "@orpc/client": "^1.14.6",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
      "vite-plus": "0.2.5",
      "vitest": "4.1.9"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "check": "vp run -r generate && vp check",
    "fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "commitlint": "commitlint",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "dev:staff": "vp run --filter staff dev",
    "dev:server": "vp run --filter server dev",
    "dev:discord": "vp run --filter discord dev",
    "db:push": "vp run --filter @bmhk-2026/db db:push",
    "db:studio": "vp run --filter @bmhk-2026/db db:studio",
    "db:generate": "vp run --filter @bmhk-2026/db db:generate",
    "db:migrate": "vp run --filter @bmhk-2026/db db:migrate",
    "services:start": "docker compose up -d",
    "services:watch": "docker compose up",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "db:seed:dev": "vp run --filter @bmhk-2026/auth db:seed:dev",
    "db:seed:auth": "vp run --filter @bmhk-2026/auth db:seed:auth",
    "db:seed:root": "vp run --filter @bmhk-2026/auth db:seed:root",
    "skill:update": "skills update -p",
    "prep:discord": "vp run --filter discord prep",
    "deploy:discord": "vp run --filter discord deploy"
  },
  "dependencies": {
    "@bmhk-2026/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bmhk-2026/config": "workspace:*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "catalog:",
    "rolldown": "1.1.4",
    "skills": "^1.5.20",
    "typescript": "catalog:",
    "ultracite": "7.9.4",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@better-auth/core": "1.6.29",
    "better-call": "1.4.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
