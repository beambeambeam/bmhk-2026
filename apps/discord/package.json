{
  "name": "discord",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "deploy": "bun scripts/gen-cmd-manifest.ts && bun run src/deploy-cmd.ts",
    "prep": "bun scripts/gen-handler-manifest.ts && bun scripts/gen-cmd-manifest.ts",
    "generate": "bun run prep",
    "dev": "bun run prep && bun run --watch src/index.ts",
    "start": "bun run prep && bun run src/deploy-if-changed.ts && bun run src/index.ts"
  },
  "dependencies": {
    "@bmhk-2026/env": "workspace:*",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "elysia": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
