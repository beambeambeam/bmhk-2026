{
  "name": "discord",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "deploy": "bun scripts/gen-cmd-manifest.ts && bun run src/deploy-commands.ts",
    "prep": "bun scripts/gen-handler-manifest.ts && bun scripts/gen-cmd-manifest.ts",
    "dev": "bun run prep && bun run --watch src/index.ts",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
